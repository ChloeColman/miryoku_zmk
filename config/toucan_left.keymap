#include "../miryoku/custom_config.h"
#include "../miryoku/mapping/42/toucan.h"
#include "../miryoku/miryoku.dtsi"

/ {
    combos {
        compatible = "zmk,combos";
        combo_base_layer {
            timeout-ms = <50>;
            key-positions = <24 35>; // LSHIFT + RSHIFT
            bindings = <&to U_BASE>;
            layers = <U_TAP U_EXTRA>; // only active on TAP and EXTRA layers
        };
    };
};
